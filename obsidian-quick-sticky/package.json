    "test": "vitest run",
    "check": "tsc -noEmit -skipLibCheck"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/remote": "^2.1.2",
    "@types/node": "^20.14.10",
    "esbuild": "^0.23.0",
    "obsidian": "latest",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
