{
  "name": "obsidian-quick-sticky",
  "version": "0.1.0",
  "private": true,
  "description": "Obsidian 桌面便签插件：独立窗口悬浮快捷笔记。",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
